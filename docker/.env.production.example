APP_NAME=Aisley
APP_ENV=production
APP_KEY=base64:REPLACE_WITH_OUTPUT_OF_php_artisan_key_generate_show
APP_DEBUG=false
APP_URL=https://api.example.com
LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=aisley
DB_USERNAME=aisley
DB_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_PASSWORD

CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
# Use .example.com only when the storefront and dashboards use subdomains of example.com.
SESSION_DOMAIN=.example.com
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Include host[:port] values only: no protocol and no trailing slash.
SANCTUM_STATEFUL_DOMAINS=example.com,www.example.com,seller.example.com,admin.example.com
# Exact browser origins only. Do not use * when supports_credentials is enabled.
CORS_ALLOWED_ORIGINS=https://example.com,https://www.example.com,https://seller.example.com,https://admin.example.com

# Remote-managed Cloudflare Tunnel token. Keep this file private and never commit it.
CLOUDFLARE_TUNNEL_TOKEN=REPLACE_WITH_YOUR_CLOUDFLARE_TUNNEL_TOKEN

# Set production URLs and credentials required by the enabled API features below.
CUSTOMER_STOREFRONT_URL=https://example.com
CUSTOMER_PASSWORD_RESET_URL=https://example.com/reset-password
SELLER_PASSWORD_RESET_URL=https://seller.example.com/reset-password
FILESYSTEM_DISK=azure
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=
AZURE_STORAGE_PREFIX=
AZURE_STORAGE_URL=
MAIL_MAILER=
MAIL_SCHEME=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"

# Optional bootstrap accounts. Set strong, unique passwords before seeding.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_FIRST_NAME=Platform
INITIAL_ADMIN_LAST_NAME=Administrator

INITIAL_SELLER_EMAIL=
INITIAL_SELLER_PASSWORD=
INITIAL_SELLER_FIRST_NAME=Aisley
INITIAL_SELLER_LAST_NAME=Catalog
INITIAL_SELLER_CONTACT_NUMBER=+639171234568
INITIAL_SELLER_BIRTH_DATE=1995-01-01

APPROVED_CUSTOMER_EMAIL=
APPROVED_CUSTOMER_PASSWORD=
APPROVED_CUSTOMER_FIRST_NAME=Aisley
APPROVED_CUSTOMER_LAST_NAME=Customer
APPROVED_CUSTOMER_CONTACT_NUMBER=+639171234567
APPROVED_CUSTOMER_BIRTH_DATE=2000-01-01
