NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_MEDIA_URL=http://localhost:8000
NEXT_PUBLIC_HOMEPAGE_DISCOVERY_PAGE_SIZE=20
NEXT_PUBLIC_HOMEPAGE_DISCOVERY_MAX_ITEMS=120
# Optional public browser key for Geoapify address autocomplete.
# Restrict it to the storefront URLs in the Geoapify dashboard.
NEXT_PUBLIC_GEOAPIFY_API_KEY=
# Optional public browser token for the embedded Mapbox GL JS location picker only.
# Restrict it to the storefront URLs and required Maps APIs in the Mapbox dashboard.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
