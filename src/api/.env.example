APP_NAME=Aisley
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5436
DB_DATABASE=aisley
DB_USERNAME=aisley
DB_PASSWORD=aisley_local

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000,localhost:5175,127.0.0.1:5175
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5175,http://127.0.0.1:5175

CUSTOMER_PASSWORD_RESET_URL=http://localhost:3000/reset-password
CUSTOMER_STOREFRONT_URL=http://localhost:3000
CUSTOMER_PASSWORD_RESET_EXPIRE_MINUTES=60
CUSTOMER_PASSWORD_RESET_THROTTLE_SECONDS=60

APPROVED_CUSTOMER_EMAIL=
APPROVED_CUSTOMER_PASSWORD=
APPROVED_CUSTOMER_FIRST_NAME=Aisley
APPROVED_CUSTOMER_LAST_NAME=Customer
APPROVED_CUSTOMER_CONTACT_NUMBER=+639171234567
APPROVED_CUSTOMER_BIRTH_DATE=2000-01-01

HOMEPAGE_DISCOVERY_DEFAULT_PAGE_SIZE=20
HOMEPAGE_DISCOVERY_MAX_PAGE_SIZE=50
HOMEPAGE_PUBLIC_CACHE_SECONDS=300
HOMEPAGE_ALLOWED_DESTINATION_HOSTS=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
