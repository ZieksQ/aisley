APP_NAME=Aisley
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5436
DB_DATABASE=aisley
DB_USERNAME=aisley
DB_PASSWORD=aisley_local

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000,localhost:5174,127.0.0.1:5174,localhost:5175,127.0.0.1:5175,localhost:5176,127.0.0.1:5176
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175,http://localhost:5176,http://127.0.0.1:5176

CUSTOMER_PASSWORD_RESET_URL=http://localhost:3000/reset-password
CUSTOMER_STOREFRONT_URL=http://localhost:3000
CUSTOMER_PASSWORD_RESET_EXPIRE_MINUTES=60
CUSTOMER_PASSWORD_RESET_THROTTLE_SECONDS=60

CHECKOUT_CURRENCY=PHP
CHECKOUT_QUOTE_TTL_MINUTES=15
# Server-owned per-Shop MVP quote until logistics/zone pricing is implemented.
CHECKOUT_SHIPPING_FEE_PER_SHOP=0.00

SELLER_PASSWORD_RESET_URL=http://localhost:5174/reset-password
SELLER_PASSWORD_RESET_EXPIRE_MINUTES=60
SELLER_PASSWORD_RESET_THROTTLE_SECONDS=60
# Must resolve to private storage (use a private Azure container). Defaults to FILESYSTEM_DISK when omitted.
SELLER_REGISTRATION_EVIDENCE_DISK=

# Seller Product images. Gallery count excludes each Variant's primary image.
SELLER_PRODUCT_ASSET_DISK=
PRODUCT_GALLERY_IMAGE_LIMIT=10
PRODUCT_DESCRIPTION_IMAGE_LIMIT=20
PRODUCT_IMAGE_MAX_EDGE=8000
PRODUCT_IMAGE_MAX_PIXELS=40000000
PRODUCT_UPLOAD_TEMP_RETENTION_HOURS=24
PRODUCT_ASSET_REPLACEMENT_RETENTION_HOURS=24
# Must remain between 7 and 30 days.
PRODUCT_DELETION_RETENTION_DAYS=30


# Optional bootstrap accounts. Set strong, unique passwords in each deployed environment.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_FIRST_NAME=Platform
INITIAL_ADMIN_LAST_NAME=Administrator

INITIAL_SELLER_EMAIL=
INITIAL_SELLER_PASSWORD=
INITIAL_SELLER_FIRST_NAME=Aisley
INITIAL_SELLER_LAST_NAME=Catalog
INITIAL_SELLER_CONTACT_NUMBER=+639171234568
INITIAL_SELLER_BIRTH_DATE=1995-01-01

INITIAL_LOGISTICS_EMAIL=
INITIAL_LOGISTICS_PASSWORD=
INITIAL_LOGISTICS_FIRST_NAME=Aisley
INITIAL_LOGISTICS_LAST_NAME=Logistics
INITIAL_LOGISTICS_CONTACT_NUMBER=+639171234569
INITIAL_LOGISTICS_BIRTH_DATE=1990-01-01
INITIAL_LOGISTICS_BUSINESS_NAME='Aisley Logistics'
INITIAL_LOGISTICS_HUB_NAME='Aisley Logistics Operational Hub'
INITIAL_LOGISTICS_ADDRESS_LINE_1='1 Logistics Center'
INITIAL_LOGISTICS_ADDRESS_LINE_2=
INITIAL_LOGISTICS_BARANGAY=Poblacion
INITIAL_LOGISTICS_CITY_MUNICIPALITY='Makati City'
INITIAL_LOGISTICS_PROVINCE='Metro Manila'
INITIAL_LOGISTICS_REGION='National Capital Region (NCR)'
INITIAL_LOGISTICS_POSTAL_CODE=1200

APPROVED_CUSTOMER_EMAIL=
APPROVED_CUSTOMER_PASSWORD=
APPROVED_CUSTOMER_FIRST_NAME=Aisley
APPROVED_CUSTOMER_LAST_NAME=Customer
APPROVED_CUSTOMER_CONTACT_NUMBER=+639171234567
APPROVED_CUSTOMER_BIRTH_DATE=2000-01-01

HOMEPAGE_DISCOVERY_DEFAULT_PAGE_SIZE=20
HOMEPAGE_DISCOVERY_MAX_PAGE_SIZE=50
HOMEPAGE_PUBLIC_CACHE_SECONDS=300
HOMEPAGE_ALLOWED_DESTINATION_HOSTS=

BROADCAST_CONNECTION=log
# local or azure
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Set FILESYSTEM_DISK=azure to store new files in Azure Blob Storage.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=
AZURE_STORAGE_PREFIX=
# Optional public/custom container URL used when generating file URLs.
AZURE_STORAGE_URL=

VITE_APP_NAME="${APP_NAME}"
