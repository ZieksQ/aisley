---
import Hero from './stitch/Hero.astro';
import Buyers from './stitch/Buyers.astro';
import Sellers from './stitch/Sellers.astro';
import Logistics from './stitch/Logistics.astro';
import Workflow from './stitch/Workflow.astro';
import Apps from './stitch/Apps.astro';
import Faq from './stitch/Faq.astro';
import Portals from './stitch/Portals.astro';
---


<header class="site-header">
<div class="header-inner">
<a class="brand" href="#main" aria-label="AISLEY home">AISLEY <span>Early access</span></a>
<nav class="site-nav" aria-label="Main navigation">
<a href="#buyers">Buyers</a><a href="#sellers">Sellers</a><a href="#logistics">Logistics</a><a href="#apps">Apps</a><a href="#workflow">Workflow</a><a href="#faq">FAQ</a>
</nav>
<a class="primary-action" href="https://aisley.app" rel="noopener noreferrer" target="_blank">Start shopping <span aria-hidden="true">→</span></a>
</div>
</header>
<main id="main" tabindex="-1">

<Hero />

<Buyers />

<Sellers />

<Logistics />

<Workflow />

<Apps />

<Faq />

<Portals />
</main>

<footer aria-labelledby="footer-title" class="bg-[var(--surface)] border-t border-[var(--border)]">
<div class="max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">

<div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-12">

<div class="md:col-span-1">
<h2 id="footer-title" class="text-lg font-bold tracking-tight text-[var(--brand-primary)] block mb-2">
            AISLEY
          </h2>
<p class="text-base text-[var(--muted)] leading-relaxed">
            A Philippine marketplace connecting buyers, independent sellers, logistics organizations, and couriers.
          </p>
</div>

<div>
<h3 class="text-sm font-bold text-[var(--ink)] mb-3">Commerce Portals</h3>
<ul class="space-y-2 text-sm">
<li>
<a class="text-[var(--muted)] hover:text-[var(--brand-primary)] transition-colors py-1 inline-block focus-visible:ring-2 focus-visible:ring-[var(--brand-primary)] focus-visible:outline-none rounded" href="https://aisley.app" rel="noopener noreferrer" target="_blank">
                Buyer Portal (aisley.app)
              </a>
</li>
<li>
<a class="text-[var(--muted)] hover:text-[var(--brand-primary)] transition-colors py-1 inline-block focus-visible:ring-2 focus-visible:ring-[var(--brand-primary)] focus-visible:outline-none rounded" href="https://seller.aisley.app" rel="noopener noreferrer" target="_blank">
                Seller Portal (seller.aisley.app)
              </a>
</li>
<li>
<a class="text-[var(--muted)] hover:text-[var(--logistics-primary)] transition-colors py-1 inline-block focus-visible:ring-2 focus-visible:ring-[var(--logistics-primary)] focus-visible:outline-none rounded" href="https://logistics.aisley.app" rel="noopener noreferrer" target="_blank">
                Logistics Portal (logistics.aisley.app)
              </a>
</li>
</ul>
</div>

<div>
<h3 class="text-sm font-bold text-[var(--ink)] mb-3">Software Releases</h3>
<ul class="space-y-2 text-sm">
<li>
<a class="text-[var(--muted)] hover:text-[var(--brand-primary)] transition-colors py-1 inline-block focus-visible:ring-2 focus-visible:ring-[var(--brand-primary)] focus-visible:outline-none rounded" href="https://github.com/ApueXI/aisley-app-customer/releases" rel="noopener noreferrer" target="_blank">
                Buyer app releases
              </a>
</li>
<li>
<a class="text-[var(--muted)] hover:text-[var(--logistics-primary)] transition-colors py-1 inline-block focus-visible:ring-2 focus-visible:ring-[var(--logistics-primary)] focus-visible:outline-none rounded" href="https://github.com/ApueXI/aisley-app-rider/releases" rel="noopener noreferrer" target="_blank">
                Rider app releases
              </a>
</li>
<li>
<span class="text-[var(--muted)] py-1 inline-block">Review available release packages</span>
</li>
</ul>
</div>

<div>
<h3 class="text-sm font-bold text-[var(--ink)] mb-3">Getting started</h3>
<ul class="space-y-2 text-sm">
<li>
<span class="text-[var(--muted)]">Seller approval</span>
</li>
<li>
<span class="text-[var(--muted)]">Courier approval</span>
</li>
<li>
<span class="text-[var(--muted)]">Early access</span>
</li>
<li>
<span class="text-[var(--muted)]">Delivery options at checkout</span>
</li>
</ul>
</div>
</div>

<div class="pt-8 border-t border-[var(--border)] flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 text-sm text-[var(--muted)]">
<p>
          © {new Date().getFullYear()} AISLEY · Early access
        </p>
<div class="flex items-center gap-2 text-[var(--brand-primary)] font-sans text-sm">
<span class="w-1.5 h-1.5 rounded-full bg-[var(--brand-primary)]"></span>
<span>info.aisley.app</span>
</div>
</div>
</div>
</footer>
