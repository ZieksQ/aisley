---
---
<section class="max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-20">
<div class="max-w-2xl mb-10">
<div class="flex items-center gap-2 mb-2">
<span class="text-sm font-semibold text-[var(--brand-primary)]">Get started</span>
</div>
<h2 class="text-2xl sm:text-3xl font-bold text-[var(--ink)] mb-3 tracking-tight">
          Choose your AISLEY workspace
        </h2>
<p class="text-base text-[var(--muted)]">Choose the workspace for your role.</p>
</div>

<div class="grid grid-cols-1 md:grid-cols-3 gap-6">

<div class="bg-[var(--surface)] border border-[var(--border)] rounded-lg p-6 flex flex-col justify-between hover:border-[var(--control-border)] transition-colors">
<div>
<div class="w-10 h-10 rounded-lg bg-[var(--brand-tint)] flex items-center justify-center text-[var(--brand-primary)] mb-4">
<svg class="stitch-icon" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="4" y="5" width="16" height="16" rx="2"/><path d="M8 5V3h8v2M8 11h8M8 15h5"/></svg>
</div>
<h3 class="text-base font-bold text-[var(--ink)] mb-2">Buyers</h3>
<p class="text-base text-[var(--muted)] leading-relaxed mb-6">Browse products and shops, place orders with Cash on Delivery, and follow order milestones.</p>
</div>
<a class="w-full min-h-[44px] px-4 inline-flex items-center justify-center rounded-lg bg-[var(--brand-primary)] hover:bg-[var(--brand-hover)] text-white text-sm font-semibold transition-colors duration-150 focus-visible:ring-2 focus-visible:ring-[var(--brand-primary)] focus-visible:outline-none" href="https://aisley.app" rel="noopener noreferrer" target="_blank">
<span>Start shopping</span>
<span class="stitch-icon" aria-hidden="true">→</span>
</a>
</div>

<div class="bg-[var(--surface)] border border-[var(--border)] rounded-lg p-6 flex flex-col justify-between hover:border-[var(--control-border)] transition-colors">
<div>
<div class="w-10 h-10 rounded-lg bg-[var(--brand-tint)] flex items-center justify-center text-[var(--brand-primary)] mb-4">
<svg class="stitch-icon" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="4" y="5" width="16" height="16" rx="2"/><path d="M8 5V3h8v2M8 11h8M8 15h5"/></svg>
</div>
<div class="flex flex-col items-start gap-2 mb-2">
<h3 class="text-base font-bold text-[var(--ink)]">Sellers</h3>
<span class="text-sm font-medium text-[var(--muted)]">Admin approval required</span>
</div>
<p class="text-base text-[var(--muted)] leading-relaxed mb-6">Manage your shop, catalog, inventory, orders, and parcel preparation.</p>
</div>
<a class="w-full min-h-[44px] px-4 inline-flex items-center justify-center rounded-lg bg-[var(--surface)] border border-[var(--control-border)] hover:bg-[var(--brand-tint)] hover:border-[var(--brand-primary)] text-[var(--ink)] text-sm font-semibold transition-colors duration-150 focus-visible:ring-2 focus-visible:ring-[var(--brand-primary)] focus-visible:outline-none" href="https://seller.aisley.app" rel="noopener noreferrer" target="_blank">
<span>Open seller portal</span>
<span class="stitch-icon" aria-hidden="true">→</span>
</a>
</div>

<div class="bg-[var(--surface)] border border-[var(--logistics-border)] rounded-lg p-6 flex flex-col justify-between hover:border-[var(--logistics-focus)] transition-colors">
<div>
<div class="w-10 h-10 rounded-lg bg-[var(--logistics-tint)] flex items-center justify-center text-[var(--logistics-primary)] mb-4">
<svg class="stitch-icon" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="4" y="5" width="16" height="16" rx="2"/><path d="M8 5V3h8v2M8 11h8M8 15h5"/></svg>
</div>
<div class="flex flex-col items-start gap-2 mb-2">
<h3 class="text-base font-bold text-[var(--ink)]">Logistics</h3>
<span class="text-sm font-semibold text-[var(--logistics-primary)]">Admin approval required</span>
</div>
<p class="text-base text-[var(--muted)] leading-relaxed mb-6">Coordinate receiving, sorting, dispatch, and your approved affiliated couriers.</p>
</div>
<a class="w-full min-h-[44px] px-4 inline-flex items-center justify-center rounded-lg bg-[var(--logistics-primary)] hover:bg-[var(--logistics-hover)] text-white text-sm font-semibold transition-colors duration-150 focus-visible:ring-2 focus-visible:ring-[var(--logistics-primary)] focus-visible:outline-none" href="https://logistics.aisley.app" rel="noopener noreferrer" target="_blank">
<span>Open logistics portal</span>
<span class="stitch-icon" aria-hidden="true">→</span>
</a>
</div>
</div>
</section>
