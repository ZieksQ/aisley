---
---
<section class="max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-20">
<div class="max-w-2xl mb-10">
<div class="flex items-center gap-2 mb-2">
<span class="text-xs uppercase tracking-wider font-semibold text-[#4c1268]">Direct Portal Access</span>
</div>
<h2 class="text-2xl sm:text-3xl font-bold text-[#231429] mb-3 tracking-tight">
          Access your dedicated AISLEY portal
        </h2>
<p class="text-base text-[#594c5e]">Choose the workspace for your role.</p>
</div>

<div class="grid grid-cols-1 md:grid-cols-3 gap-6">

<div class="bg-[#ffffff] border border-[#e5dce7] rounded-lg p-6 flex flex-col justify-between hover:border-[#cfc1d2] transition-colors">
<div>
<div class="w-10 h-10 rounded-lg bg-[#f1ebf3] flex items-center justify-center text-[#4c1268] mb-4">
<svg class="stitch-icon" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="4" y="5" width="16" height="16" rx="2"/><path d="M8 5V3h8v2M8 11h8M8 15h5"/></svg>
</div>
<h3 class="text-base font-bold text-[#231429] mb-2">Buyers</h3>
<p class="text-xs text-[#594c5e] leading-relaxed mb-6">Browse products and shops, place orders with Cash on Delivery, and follow order milestones.</p>
</div>
<a class="w-full min-h-[44px] px-4 inline-flex items-center justify-center rounded-lg bg-[#4c1268] hover:bg-[#3d0e54] text-white text-xs font-semibold transition-colors duration-150 focus-visible:ring-2 focus-visible:ring-[#4c1268] focus-visible:outline-none" href="https://aisley.app" rel="noopener noreferrer" target="_blank">
<span>Launch aisley.app</span>
<span class="stitch-icon" aria-hidden="true">→</span>
</a>
</div>

<div class="bg-[#ffffff] border border-[#e5dce7] rounded-lg p-6 flex flex-col justify-between hover:border-[#cfc1d2] transition-colors">
<div>
<div class="w-10 h-10 rounded-lg bg-[#f1ebf3] flex items-center justify-center text-[#4c1268] mb-4">
<svg class="stitch-icon" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="4" y="5" width="16" height="16" rx="2"/><path d="M8 5V3h8v2M8 11h8M8 15h5"/></svg>
</div>
<div class="flex items-center justify-between mb-2">
<h3 class="text-base font-bold text-[#231429]">Sellers</h3>
<span class="text-[11px] font-medium text-[#7d6f83]">Admin approval required</span>
</div>
<p class="text-xs text-[#594c5e] leading-relaxed mb-6">Manage your shop, catalog, inventory, orders, and parcel preparation.</p>
</div>
<a class="w-full min-h-[44px] px-4 inline-flex items-center justify-center rounded-lg bg-[#ffffff] border border-[#cfc1d2] hover:bg-[#f1ebf3] hover:border-[#4c1268] text-[#231429] text-xs font-semibold transition-colors duration-150 focus-visible:ring-2 focus-visible:ring-[#4c1268] focus-visible:outline-none" href="https://seller.aisley.app" rel="noopener noreferrer" target="_blank">
<span>Open seller.aisley.app</span>
<span class="stitch-icon" aria-hidden="true">→</span>
</a>
</div>

<div class="bg-[#ffffff] border border-[#bfdbfe] rounded-lg p-6 flex flex-col justify-between hover:border-[#93c5fd] transition-colors">
<div>
<div class="w-10 h-10 rounded-lg bg-[#eff6ff] flex items-center justify-center text-[#2563eb] mb-4">
<svg class="stitch-icon" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="4" y="5" width="16" height="16" rx="2"/><path d="M8 5V3h8v2M8 11h8M8 15h5"/></svg>
</div>
<div class="flex items-center justify-between mb-2">
<h3 class="text-base font-bold text-[#231429]">Logistics</h3>
<span class="text-[11px] font-semibold text-[#2563eb]">Admin approval required</span>
</div>
<p class="text-xs text-[#594c5e] leading-relaxed mb-6">Coordinate receiving, sorting, dispatch, and your approved affiliated couriers.</p>
</div>
<a class="w-full min-h-[44px] px-4 inline-flex items-center justify-center rounded-lg bg-[#2563eb] hover:bg-[#1d4ed8] text-white text-xs font-semibold transition-colors duration-150 focus-visible:ring-2 focus-visible:ring-[#2563eb] focus-visible:outline-none" href="https://logistics.aisley.app" rel="noopener noreferrer" target="_blank">
<span>Open logistics.aisley.app</span>
<span class="stitch-icon" aria-hidden="true">→</span>
</a>
</div>
</div>
</section>
