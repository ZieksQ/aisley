---
import Preview from '../Preview.astro';
---
<section class="max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-20 border-b border-[#e5dce7]" id="buyers">
<div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">

<div class="lg:col-span-7">
<div class="flex items-center gap-2 mb-2">
<span class="text-xs uppercase tracking-wider font-semibold text-[#4c1268]">Customer Experience</span>
</div>
<h2 class="text-2xl sm:text-3xl font-bold text-[#231429] mb-4 tracking-tight">
            Discover independent shops and follow your orders
          </h2>
<p class="text-base text-[#594c5e] leading-relaxed mb-6">Explore independent shops, find products, and place orders with Cash on Delivery. Follow order milestones from preparation through delivery.</p>
<div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-8">
<div class="p-3.5 bg-[#ffffff] border border-[#e5dce7] rounded-lg">
<div class="text-xs font-bold text-[#231429] mb-1 flex items-center gap-1.5">
<svg class="stitch-icon" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="4" y="5" width="16" height="16" rx="2"/><path d="M8 5V3h8v2M8 11h8M8 15h5"/></svg>
                Products and shops
              </div>
<p class="text-xs text-[#594c5e]">Browse products and independent shops.</p>
</div>
<div class="p-3.5 bg-[#ffffff] border border-[#e5dce7] rounded-lg">
<div class="text-xs font-bold text-[#231429] mb-1 flex items-center gap-1.5">
<svg class="stitch-icon" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="4" y="5" width="16" height="16" rx="2"/><path d="M8 5V3h8v2M8 11h8M8 15h5"/></svg>
                Cash on Delivery (COD)
              </div>
<p class="text-xs text-[#594c5e]">Choose the available payment and delivery options at checkout.</p>
</div>
<div class="p-3.5 bg-[#ffffff] border border-[#e5dce7] rounded-lg">
<div class="text-xs font-bold text-[#231429] mb-1 flex items-center gap-1.5">
<svg class="stitch-icon" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="4" y="5" width="16" height="16" rx="2"/><path d="M8 5V3h8v2M8 11h8M8 15h5"/></svg>
                Sequential Checkpoints
              </div>
<p class="text-xs text-[#594c5e]">Follow recorded shipment milestones from preparation through delivery.</p>
</div>
<div class="p-3.5 bg-[#ffffff] border border-[#e5dce7] rounded-lg">
<div class="text-xs font-bold text-[#231429] mb-1 flex items-center gap-1.5">
<svg class="stitch-icon" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="4" y="5" width="16" height="16" rx="2"/><path d="M8 5V3h8v2M8 11h8M8 15h5"/></svg>
                Instant Web Access
              </div>
<p class="text-xs text-[#594c5e]">Shop through the web portal without installing an app.</p>
</div>
</div>
<a class="min-h-[44px] px-5 inline-flex items-center justify-center rounded-lg bg-[#4c1268] hover:bg-[#3d0e54] text-white text-sm font-semibold transition-colors duration-150 focus-visible:ring-2 focus-visible:ring-[#4c1268] focus-visible:outline-none" href="https://aisley.app" rel="noopener noreferrer" target="_blank">
<span>Explore buyer marketplace</span>
<span class="stitch-icon" aria-hidden="true">→</span>
</a>
</div>
<div class="lg:col-span-5"><div class="bg-[#ffffff] border border-[#e5dce7] rounded-lg p-5 shadow-sm"><div class="text-xs text-[#594c5e] mb-4">Buyer marketplace</div><Preview src="/screens/buyer.webp" title="Buyer marketplace" width={1280} height={850} /></div></div>
</div></section>
