---
import Preview from '../Preview.astro';
---
<section id="hero" class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center pt-2">

  <div class="lg:col-span-7 flex flex-col justify-center">
    <div class="inline-flex items-center gap-2 mb-4">
      <span class="text-xs font-semibold uppercase tracking-wider text-primaryPurple px-2.5 py-1 bg-tintPurple rounded-[6px] border border-borderPurple">
        Philippine Marketplace
      </span>
    </div>

    <h1 class="text-4xl sm:text-5xl lg:text-[56px] font-bold tracking-tight text-ink leading-[1.12] mb-6">
      Shop independent sellers.
    </h1>

    <p class="text-lg md:text-xl text-muted leading-relaxed mb-8 max-w-xl">
      Find products from independent shops on AISLEY, a Philippine marketplace with Cash on Delivery and order updates.
    </p>

    <div class="flex flex-wrap items-center gap-4 sm:gap-6 mb-8">
      <a href="https://aisley.app"
         class="inline-flex items-center justify-center min-h-[44px] px-6 py-3 bg-primaryPurple hover:bg-primaryHover text-surface text-base font-semibold rounded-[8px] transition-colors shadow-sm"
         target="_blank" rel="noopener noreferrer">
        Start shopping
      </a>
      <div class="flex items-center gap-4 text-sm font-medium">
        <a href="https://seller.aisley.app"
           class="inline-flex items-center min-h-[44px] py-2 text-ink hover:text-primaryPurple underline underline-offset-4 decoration-borderPurple hover:decoration-primaryPurple transition-colors"
           target="_blank" rel="noopener noreferrer">
          Seller portal
        </a>
        <span class="text-borderPurple select-none" aria-hidden="true">|</span>
        <a href="https://logistics.aisley.app"
           class="inline-flex items-center min-h-[44px] py-2 text-ink hover:text-logisticsBlue underline underline-offset-4 decoration-borderPurple hover:decoration-logisticsBlue transition-colors focus-blue"
           target="_blank" rel="noopener noreferrer">
          Logistics portal
        </a>
      </div>
    </div>

    <div class="flex items-start gap-2.5 pt-4 border-t border-borderPurple max-w-lg">
      <svg class="w-4 h-4 text-muted mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <p class="text-xs text-muted leading-normal">
        Early access · Products and delivery options depend on participating shops and coverage.
      </p>
    </div>
  </div>

  <div class="lg:col-span-5">
    <Preview src="/screens/buyer.webp" title="AISLEY storefront" channel="aisley.app · storefront" width={1280} height={850} eager />
  </div>
</section>
