---
import Preview from '../Preview.astro';
---
<section class="hero max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8 border-b border-[var(--border)]" aria-labelledby="hero-title">
<div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-start">
<div class="lg:col-span-7">
<h1 id="hero-title">Shop independent sellers.</h1>
<p class="hero-intro">Find products from independent shops on AISLEY, a Philippine marketplace with Cash on Delivery and order updates.</p>
<a class="primary-action" href="https://aisley.app" rel="noopener noreferrer" target="_blank">Start shopping <span aria-hidden="true">→</span></a>
<p class="hero-portals">Here for your business? <a href="https://seller.aisley.app" rel="noopener noreferrer" target="_blank">Seller portal</a><a href="https://logistics.aisley.app" rel="noopener noreferrer" target="_blank">Logistics portal</a></p>
<p class="hero-note">Early access · Products and delivery options depend on participating shops and coverage.</p>
</div>
<div class="lg:col-span-5"><div class="bg-[var(--surface)] border border-[var(--border)] rounded-lg p-5 shadow-sm"><div class="text-sm text-[var(--muted)] mb-4">AISLEY storefront</div><Preview eager src="/screens/buyer.webp" title="AISLEY storefront" width={1280} height={850} /></div></div>
</div></section>
