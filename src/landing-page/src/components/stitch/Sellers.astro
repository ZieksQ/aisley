---
import Preview from '../Preview.astro';
---
<section class="max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-20 border-b border-[var(--border)]" id="sellers">
<div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
<div class="lg:col-span-5 order-2 lg:order-1"><div class="bg-[var(--surface)] border border-[var(--border)] rounded-lg p-5 shadow-sm"><div class="text-sm text-[var(--muted)] mb-4">Seller product catalog</div><Preview src="/screens/seller.webp" title="Seller product catalog" width={780} height={437} /></div></div>

<div class="lg:col-span-7 order-1 lg:order-2">
<div class="flex items-center gap-2 mb-2">
<span class="text-sm font-semibold text-[var(--brand-primary)]">For sellers</span>
</div>
<h2 class="text-2xl sm:text-3xl font-bold text-[var(--ink)] mb-4 tracking-tight">
            Manage your shop and orders
          </h2>

<div class="bg-[var(--brand-tint)] border border-[var(--control-border)] rounded-lg p-3.5 mb-6 flex items-start gap-2.5">
<svg class="stitch-icon" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="4" y="5" width="16" height="16" rx="2"/><path d="M8 5V3h8v2M8 11h8M8 15h5"/></svg>
<p class="text-base font-semibold text-[var(--brand-primary)]">Seller access requires Admin approval. Complete the registration requirements before using the Seller dashboard.</p>
</div>
<p class="text-base text-[var(--muted)] leading-relaxed mb-6">Manage your products, inventory, and incoming orders in one workspace. Prepare parcels and request pickup from your selected logistics provider.</p>
<div class="space-y-3 mb-8">
<div class="flex items-start gap-3">
<svg class="stitch-icon" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="4" y="5" width="16" height="16" rx="2"/><path d="M8 5V3h8v2M8 11h8M8 15h5"/></svg>
<div>
<h3 class="text-sm font-semibold text-[var(--ink)]">Products and inventory</h3>
<p class="text-base text-[var(--muted)]">Manage your shop catalog and product inventory.</p>
</div>
</div>
<div class="flex items-start gap-3">
<svg class="stitch-icon" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="4" y="5" width="16" height="16" rx="2"/><path d="M8 5V3h8v2M8 11h8M8 15h5"/></svg>
<div>
<h3 class="text-sm font-semibold text-[var(--ink)]">Parcel preparation and waybills</h3>
<p class="text-base text-[var(--muted)]">Prepare parcels and print waybills for fulfillment.</p>
</div>
</div>
<div class="flex items-start gap-3">
<svg class="stitch-icon" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="4" y="5" width="16" height="16" rx="2"/><path d="M8 5V3h8v2M8 11h8M8 15h5"/></svg>
<div>
<h3 class="text-sm font-semibold text-[var(--ink)]">Order management</h3>
<p class="text-base text-[var(--muted)]">Keep track of incoming orders and their progress.</p>
</div>
</div>
</div>
<a class="min-h-[44px] px-5 inline-flex items-center justify-center rounded-lg bg-[var(--surface)] border border-[var(--control-border)] hover:bg-[var(--brand-tint)] hover:border-[var(--brand-primary)] text-[var(--ink)] text-sm font-semibold transition-colors duration-150 focus-visible:ring-2 focus-visible:ring-[var(--brand-primary)] focus-visible:outline-none" href="https://seller.aisley.app" rel="noopener noreferrer" target="_blank">
<span>Open seller portal</span>
<span class="stitch-icon" aria-hidden="true">→</span>
</a>
</div>
</div>
</section>
